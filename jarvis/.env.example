ANTHROPIC_API_KEY=sua_chave_aqui
JARVIS_MODEL=claude-sonnet-5

# Detecção de palma no modo voz: se ajusta sozinha ao barulho do ambiente. Uma palma precisa
# ser JARVIS_MULTIPLICADOR_PALMA vezes mais alta que o ruído de fundo (aumente se ele disparar
# sozinho, diminua se não detectar suas palmas). JARVIS_LIMIAR_PALMA_MINIMO evita falsos
# positivos em ambientes muito silenciosos.
JARVIS_MULTIPLICADOR_PALMA=2
JARVIS_LIMIAR_PALMA_MINIMO=300

# Opcional: integração com Home Assistant para controlar dispositivos inteligentes
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
