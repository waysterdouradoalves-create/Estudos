ANTHROPIC_API_KEY=sua_chave_aqui
JARVIS_MODEL=claude-sonnet-5

# Sensibilidade da detecção de palma no modo voz (menor = mais sensível). Se ele não
# detectar suas palmas, diminua; se disparar sozinho com barulhos do ambiente, aumente.
JARVIS_LIMIAR_PALMA=4000

# Opcional: integração com Home Assistant para controlar dispositivos inteligentes
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
